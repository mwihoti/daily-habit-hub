# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Web3 — Avalanche ──────────────────────────────────────────────────────────
# Contract addresses (Fuji testnet — replace with mainnet addresses for production)
NEXT_PUBLIC_HABIT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HABIT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ACHIEVEMENT_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Admin wallet private key — NEVER commit the real value, use Vercel secrets
# Generate a fresh wallet for deployment: https://vanity-eth.tk/
PRIVATE_ADMIN_KEY=0x_your_admin_wallet_private_key

# ─── IPFS (Pinata) — optional ──────────────────────────────────────────────────
# Without these, workout metadata uses base64 data URIs (works, just not real IPFS)
# Get free keys at https://pinata.cloud
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key

# ─── Contract verification (optional) ─────────────────────────────────────────
# Get a free Snowtrace API key at https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=your-snowtrace-api-key

# ─── Push Notifications (Web Push / VAPID) ────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
# Public key goes to the client (NEXT_PUBLIC_ prefix), private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Must be a mailto: or https: URL identifying who is sending the notifications
VAPID_SUBJECT=mailto:admin@fittribe.ke
# Secret for the /api/push/send broadcast endpoint (choose any random string)
PUSH_SEND_SECRET=your-push-send-secret
# Secret Vercel Cron uses to call /api/push/reminders (set the same value in Vercel env)
CRON_SECRET=your-cron-secret

# ─── Server-only Supabase key ─────────────────────────────────────────────────
# Used by cron reminders and the on-chain mint audit log — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── AI Accountability Summaries (optional) ───────────────────────────────────
# Provider selection: auto | gemini | openrouter | off
ACCOUNTABILITY_AI_PROVIDER=auto

# Gemini API (primary if configured in auto mode)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (fallback or alternate provider)
# For zero-cost routing, keep the default model as openrouter/free
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
# Optional headers recommended by OpenRouter
OPENROUTER_HTTP_REFERER=https://your-app.example
OPENROUTER_APP_TITLE=FitTribe
